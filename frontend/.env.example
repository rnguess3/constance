# Copie ce fichier en ".env" (cp .env.example .env) puis renseigne tes
# propres valeurs. Le fichier .env ne doit JAMAIS être commité dans Git
# (il est déjà exclu par le .gitignore).

# Clé PUBLIQUE Clerk (préfixe pk_...) — à récupérer sur
# https://dashboard.clerk.com > ton appli > API Keys.
# C'est une clé publique par design : elle est volontairement visible
# dans le code JS envoyé au navigateur (contrairement à CLERK_SECRET_KEY,
# qui elle ne doit exister QUE côté backend). Vite n'expose au navigateur
# que les variables préfixées VITE_ — c'est pour ça que celle-ci l'est et
# pas les autres.
VITE_CLERK_PUBLISHABLE_KEY=

# URL de base de l'API backend
VITE_API_URL="http://localhost:3001"
