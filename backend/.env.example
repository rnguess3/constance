# Copie ce fichier en ".env" (cp .env.example .env) puis renseigne tes
# propres valeurs. Le fichier .env ne doit JAMAIS être commité dans Git
# (il est déjà exclu par le .gitignore).

# URL de connexion à la base PostgreSQL, format attendu par Prisma :
# postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/constance?schema=public"

# Port sur lequel le serveur Express écoute en local
PORT=3001

# Origine autorisée pour les appels CORS depuis le frontend (Vite en dev)
FRONTEND_URL="http://localhost:5173"

# Clés d'authentification (Clerk ou Supabase Auth — à choisir plus tard)
# CLERK_SECRET_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
