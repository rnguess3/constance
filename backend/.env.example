# Copie ce fichier en ".env" (cp .env.example .env) puis renseigne tes
# propres valeurs. Le fichier .env ne doit JAMAIS être commité dans Git
# (il est déjà exclu par le .gitignore).

# URL de connexion à la base PostgreSQL, format attendu par Prisma :
# postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/constance?schema=public"

# Port sur lequel le serveur Express écoute en local
PORT=3001

# Origine autorisée pour les appels CORS depuis le frontend (Vite en dev)
FRONTEND_URL="http://localhost:5173"

# Clés Clerk — à récupérer sur https://dashboard.clerk.com > ton appli >
# API Keys. Les deux sont nécessaires côté backend (le SDK @clerk/express
# s'en sert pour construire le contexte de vérification des tokens).
# CLERK_SECRET_KEY est secrète (backend UNIQUEMENT, jamais exposée au
# frontend) ; CLERK_PUBLISHABLE_KEY est la même valeur publique que celle
# utilisée côté frontend (VITE_CLERK_PUBLISHABLE_KEY).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Clés VAPID — identifient ce serveur auprès des services de push des
# navigateurs (Chrome/Firefox/Edge...) pour l'envoi des rappels. Se
# génèrent une seule fois avec `npx web-push generate-vapid-keys` (paquet
# déjà en dépendance) et ne changent plus ensuite : régénérer ces clés
# invaliderait tous les abonnements déjà enregistrés en base, qui
# devraient se réabonner. VAPID_PUBLIC_KEY est la même valeur que
# VITE_VAPID_PUBLIC_KEY côté frontend (public par design, comme les clés
# Clerk ci-dessus) ; VAPID_PRIVATE_KEY est secrète (backend UNIQUEMENT).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact affiché aux services de push en cas de souci (obligatoire par la
# spec Web Push) — un mailto: ou une URL https:// vers ton site.
VAPID_SUBJECT="mailto:contact@example.com"
